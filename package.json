{
  "name": "dsh-dfy-qq",
  "version": "0.5.3",
  "description": "QQ 对话行为层：人设装载、群友关系档案、表情包择机发送、主动接话、子人格、群聊短期记忆",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/beiheng127/dsh-dfy-qq.git"
  },
  "homepage": "https://github.com/beiheng127/dsh-dfy-qq",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "qq",
    "onebot",
    "persona",
    "emoji"
  ]
}
